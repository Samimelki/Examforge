# Copy to .env for local dev
POSTGRES_USER=examforge
POSTGRES_PASSWORD=examforge
POSTGRES_DB=examforge

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminadmin
MINIO_HOST=minio.localhost

OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

DASHBOARDS_HOST=osd.localhost
QDRANT_HOST=qdrant.localhost

# External Ollama on host (used by services in containers)
OLLAMA_BASE_URL=http://host.docker.internal:11434
